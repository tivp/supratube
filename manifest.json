{
    "manifest_version": 3,
    "name": "SupraTube",
    "version": "1.0.13",
    "description": "Equilibra YouTube conservando lo vanilla: moddea solo lo injusto (anuncios, calidad baja y subtítulos que no se activan).",
    "author": "tivp",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon-128.png",
        "default_title": "SupraTube"
    },
    "permissions": [
        "storage",
        "scripting",
        "tabs",
        "userScripts",
        "offscreen"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://sponsor.ajay.app/*",
        "https://ipapi.co/*",
        "https://freeipapi.com/*",
        "https://ipwho.is/*",
        "https://api.country.is/*",
        "https://raw.githubusercontent.com/*",
        "https://api.github.com/*",
        "https://translate.googleapis.com/*",
        "https://clients5.google.com/*",
        "https://api.mymemory.translated.net/*",
        "https://huggingface.co/*",
        "https://*.huggingface.co/*",
        "https://*.hf.co/*",
        "https://*.xethub.hf.co/*",
        "https://cdn-lfs.huggingface.com/*",
        "https://cdn-lfs-us-1.hf.co/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ],
            "js": [
                "page-hook.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "modules/*.js",
                "icons/*.png"
            ],
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ]
        }
    ]
}
